{
  "name": "remotion-starter",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "start": "remotion studio",
    "build": "remotion render HelloWorld out/hello.mp4",
    "sketch": "remotion render PencilSketch out/sketch.mp4",
    "curve": "remotion render VideoCurve out/curve.mp4",
    "edit": "remotion render DanceEdit out/edit.mp4",
    "edit2": "remotion render DanceEdit2 out/edit2.mp4",
    "natasha": "remotion render NatashaEdit out/natasha.mp4",
    "bubble": "remotion render NatashaBubble out/bubble.mp4 --concurrency=2",
    "comic": "remotion render NatashaComic out/comic.mp4 --concurrency=2",
    "app": "vite --config app/vite.config.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "bundle": "remotion bundle src/index.ts --out-dir=build",
    "serve": "node server/server.mjs",
    "comicjson": "remotion render ComicEdit out/comicjson.mp4 --props=scripts/natasja.json --concurrency=2"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.538",
    "@remotion/google-fonts": "^4.0.538",
    "@remotion/media-utils": "^4.0.538",
    "@remotion/player": "^4.0.538",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.538"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
